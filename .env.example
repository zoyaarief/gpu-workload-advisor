# Required only by POST /advise. Never commit a real key.
GROQ_API_KEY=replace-me

# A small, tool-capable model keeps the MVP inexpensive and responsive.
GROQ_MODEL=openai/gpt-oss-20b

BENCHMARK_EXECUTABLE=./build/benchmark_runner
MAX_MATRIX_SIZE=2048
BENCHMARK_TIMEOUT_SECONDS=120

# Trials per implementation; latency is the median. Max 50.
BENCHMARK_REPEATS=5
# NVML sampling period for GPU telemetry.
TELEMETRY_INTERVAL_MS=50
